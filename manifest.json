{
  "manifest_version": 3,
  "name": "GradePreview for StudentVUE",
  "version": "1.4.0",
  "description": "Preview how assignment and test scores affect your StudentVUE grade.",
  "content_scripts": [
    {
      "matches": [
        "https://synergyportal.anoka.k12.mn.us/*"
      ],
      "js": [
        "core.js",
        "importer.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "GradePreview for StudentVUE"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "gradepreview-for-studentvue@verityhoangjacob67",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
